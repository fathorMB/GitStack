#!/bin/sh
# gitstack-build - costruisce e pubblica un'immagine OCI dal pod di un job `runs-on: gitstack-build`
# (ADR 0001 §6, CI2, GIT-371). Usa BuildKit rootless (sidecar del pod, socket in BUILDKIT_HOST) e
# pubblica nel registry del repo del job passando dal gateway nel cluster, col token del job.
#
#   gitstack-build --tag 1.0 [--name sub] [--file Dockerfile] [--build-arg K=V]... [contesto]
#
# L'immagine e' <registry>/<owner>/<repo>[/<name>]:<tag>: il repo e' sempre quello del job (il
# suo token non vale per altri). Variabili usate: GITSTACK_REGISTRY e BUILDKIT_HOST (le mette il
# pod), GITSTACK_REPOSITORY (owner/nome, la mette il runner) e GITHUB_TOKEN (act).
set -eu

die() { echo "gitstack-build: $*" >&2; exit 1; }

tag=""
name=""
file="Dockerfile"
ctx="."
args=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tag) [ $# -ge 2 ] || die "--tag vuole un valore"; tag="$2"; shift 2 ;;
    --name) [ $# -ge 2 ] || die "--name vuole un valore"; name="$2"; shift 2 ;;
    --file) [ $# -ge 2 ] || die "--file vuole un valore"; file="$2"; shift 2 ;;
    --build-arg) [ $# -ge 2 ] || die "--build-arg vuole K=V"; args="${args}
$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    -*) die "opzione sconosciuta: $1" ;;
    *) ctx="$1"; shift ;;
  esac
done

[ -n "${tag}" ] || die "serve --tag"
[ -n "${GITSTACK_REGISTRY:-}" ] || die "GITSTACK_REGISTRY assente: il job deve avere runs-on: gitstack-build"
[ -n "${BUILDKIT_HOST:-}" ] || die "BUILDKIT_HOST assente: il job deve avere runs-on: gitstack-build"
[ -n "${GITHUB_TOKEN:-}" ] || die "GITHUB_TOKEN assente"
[ -n "${GITSTACK_REPOSITORY:-}" ] || die "GITSTACK_REPOSITORY assente"
[ -f "${file}" ] || die "Dockerfile non trovato: ${file}"
[ -d "${ctx}" ] || die "contesto non trovato: ${ctx}"

repo="$(printf '%s' "${GITSTACK_REPOSITORY}" | tr '[:upper:]' '[:lower:]')"
ref="${GITSTACK_REGISTRY}/${repo}"
if [ -n "${name}" ]; then ref="${ref}/${name}"; fi
ref="${ref}:${tag}"

# Credenziali per il solo registry del cluster: il token resta nel file del job (/work, effimero).
export DOCKER_CONFIG="${DOCKER_CONFIG:-${HOME:-/work}/.docker}"
mkdir -p "${DOCKER_CONFIG}"
chmod 700 "${DOCKER_CONFIG}"
umask 077
auth="$(printf 'token:%s' "${GITHUB_TOKEN}" | base64 | tr -d '\n')"
printf '{"auths":{"%s":{"auth":"%s"}}}\n' "${GITSTACK_REGISTRY}" "${auth}" >"${DOCKER_CONFIG}/config.json"

# buildkitd e' un sidecar: parte dopo il gate e puo' metterci qualche secondo.
i=0
until buildctl debug workers >/dev/null 2>&1; do
  i=$((i + 1))
  [ "${i}" -lt 90 ] || die "buildkitd non risponde su ${BUILDKIT_HOST}"
  sleep 1
done

set -- build --frontend dockerfile.v0 \
  --local "context=${ctx}" --local "dockerfile=$(dirname "${file}")" --opt "filename=$(basename "${file}")"
oldifs="${IFS}"
IFS='
'
for kv in ${args}; do
  [ -n "${kv}" ] && set -- "$@" --opt "build-arg:${kv}"
done
IFS="${oldifs}"
# registry.insecure: il gateway nel cluster parla HTTP (nome di Service, non un host pubblico con TLS).
set -- "$@" --output "type=image,name=${ref},push=true,registry.insecure=true"
echo "gitstack-build: costruisco e pubblico ${ref}"
buildctl "$@"
echo "gitstack-build: pubblicata ${ref}"
