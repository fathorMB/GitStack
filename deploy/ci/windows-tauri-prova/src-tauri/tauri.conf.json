{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GsTauriProva",
  "version": "0.1.0",
  "identifier": "lan.gitstack.prova",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GitStack prova",
        "width": 600,
        "height": 400
      }
    ],
    "security": {
      "csp": null
