# Nodo di prova per deploy/test-network/run.sh: un Ubuntu 24.04 con systemd,
# dove install.sh installa k3s e GitStack come su una macchina vera. Costruito
# con la rete dell'host (apt); poi gira in una rete senza uscita.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv ca-certificates curl iproute2 openssl iptables kmod \
      procps util-linux sudo tar gzip gawk dbus \
 && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
