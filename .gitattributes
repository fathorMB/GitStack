# Testo Unix (LF) per gli script eseguiti in bash e per il Makefile: su un
# checkout Windows con core.autocrlf=true, un CRLF in una continuazione di
# riga ("\") o in uno shebang può rompere l'esecuzione (es.
# "$'\r': command not found" — riprodotto durante GIT-10 sul Makefile di
# dev-up/dev-down/dev-redeploy). Non normalizza il resto del repo: solo gli
# script eseguiti direttamente da una shell POSIX.
Makefile text eol=lf
*.sh text eol=lf

# tokens.css e' generato da web/scripts/sync-tokens.mjs, che scrive sempre LF: con
# core.autocrlf=true il worktree Windows lo avrebbe CRLF e dopo
# "pnpm run check-tokens" git lo vedrebbe modificato (GIT-46).
web/src/styles/tokens.css text eol=lf

# Le due copie del bootstrap SQL di identity devono restare byte-identiche
# (il job "chart" della CI le confronta con diff) anche su un checkout Windows.
services/identity/migrations/bootstrap-role.sql text eol=lf
deploy/gitstack/files/identity-bootstrap-role.sql text eol=lf
