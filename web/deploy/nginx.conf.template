# Template nginx per il container web/ (vedi web/Dockerfile). Renderizzato
# dall'entrypoint dell'immagine base (envsubst sulle sole variabili
# d'ambiente definite, non sulle variabili nginx $host/$uri/...: vedi
# /docker-entrypoint.d/20-envsubst-on-templates.sh nell'immagine
# nginxinc/nginx-unprivileged) in /etc/nginx/conf.d/default.conf all'avvio.
#
# GATEWAY_UPSTREAM è l'unico posto in cui questa immagine sa dove trovare il
# gateway: il chart Helm di GIT-8 lo sovrascrive con il nome del Service
# k3s. La SPA non lo conosce, chiama solo l'URL relativo /api/... (D7,
# API-first) — vedi web/src/lib/resourcesApi.ts.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        # Risoluzione di GATEWAY_UPSTREAM a ogni richiesta (resolver +
        # variabile in proxy_pass), non una sola volta all'avvio: senza
        # questo nginx non parte se il gateway non è ancora raggiungibile
        # quando il pod web/ si avvia (ordine di avvio non garantito in
        # k3s), e non segue un eventuale cambio di IP. NGINX_LOCAL_RESOLVERS
        # viene da /etc/nginx/docker-entrypoint.d/15-local-resolvers.envsh
        # (immagine base), letto da /etc/resolv.conf del pod (il resolver
        # DNS del cluster, es. CoreDNS in k3s).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        # proxy_pass con variabile non fa il riscrittura automatica dell'URI
        # (regola di nginx per i proxy_pass "dinamici"): la si fa a mano con
        # rewrite ... break, così /api/resources arriva al gateway come
        # /v1/resources.
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: qualunque percorso non statico ricade su index.html (routing lato
    # client, quando arriverà un router — vedi src/App.tsx).
    location / {
        try_files $uri /index.html;
    }
}
