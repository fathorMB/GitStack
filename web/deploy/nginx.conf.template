# Template nginx per il container web/ (vedi web/Dockerfile). Renderizzato
# dall'entrypoint dell'immagine base (envsubst sulle sole variabili
# d'ambiente definite, non sulle variabili nginx $host/$uri/...: vedi
# /docker-entrypoint.d/20-envsubst-on-templates.sh nell'immagine
# nginxinc/nginx-unprivileged) in /etc/nginx/conf.d/default.conf all'avvio.
#
# GATEWAY_UPSTREAM è l'unico posto in cui questa immagine sa dove trovare il
# gateway: il chart Helm di GIT-8 lo sovrascrive con il nome del Service
# k3s. La SPA non lo conosce, chiama solo l'URL relativo /api/v1/... (D7,
# API-first) — vedi web/src/lib/resourcesApi.ts.
# Schema con cui il client ha raggiunto l'istanza: dietro Traefik (TLS
# terminato li) viene da X-Forwarded-Proto. Serve a scrivere l'indirizzo
# giusto negli script di installazione di gs (GIT-171).
map $http_x_forwarded_proto $gs_scheme {
    default $scheme;
    https   https;
    http    http;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        default_type text/plain;
        return 200 "ok";
    }

    # Distribuzione di gs (GIT-171, G6) e certificato della CA (N5, GIT-143).
    # Pubblico: servono per fare login, prima di avere un token. I file stanno
    # DENTRO l'immagine (build-gs-dist.sh, stage gs del Dockerfile): niente
    # internet a runtime. Gli script di installazione ricevono l'indirizzo con
    # cui sono stati raggiunti al posto del segnaposto (sub_filter): dietro
    # Traefik lo schema viene da X-Forwarded-Proto.
    # "location = /downloads" (senza slash) resta alla SPA (pagina della UI).
    location ^~ /downloads/ {
        default_type application/octet-stream;
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
    }

    location = /downloads/SHA256SUMS {
        default_type text/plain;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
    }

    # index.json lo scrive l'entrypoint (30-gs-index.sh) in /tmp: ca_cert
    # dipende dall istanza.
    location = /downloads/index.json {
        alias /tmp/gs-index.json;
        default_type application/json;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
    }

    # Certificato PUBBLICO della CA interna: il chart monta il ConfigMap
    # <release>-ca (chiave ca.crt) in /etc/gitstack/ca. Senza il file
    # (certificato del cliente o Let s Encrypt) la risposta e 404, non il
    # fallback SPA con un 200 HTML.
    location = /downloads/ca.crt {
        alias /etc/gitstack/ca/ca.crt;
        default_type application/x-x509-ca-cert;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
    }

    location ~ ^/install-gs.(sh|ps1)$ {
        root /usr/share/nginx/html;
        default_type text/plain;
        sub_filter_types *;
        sub_filter_once off;
        sub_filter "__GS_BASE_URL__" "$gs_scheme://$http_host";
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
    }

    # ^~: il prefisso /api/ vince sulla location regex del raw qui sotto, così
    # /api/<x>/raw/... non viene scambiato per un raw di file.
    location ^~ /api/ {
        # Risoluzione di GATEWAY_UPSTREAM a ogni richiesta (resolver +
        # variabile in proxy_pass), non una sola volta all'avvio: senza
        # questo nginx non parte se il gateway non è ancora raggiungibile
        # quando il pod web/ si avvia (ordine di avvio non garantito in
        # k3s), e non segue un eventuale cambio di IP. NGINX_LOCAL_RESOLVERS
        # viene da /etc/nginx/docker-entrypoint.d/15-local-resolvers.envsh
        # (immagine base), letto da /etc/resolv.conf del pod (il resolver
        # DNS del cluster, es. CoreDNS in k3s).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        # proxy_pass con variabile non fa il riscrittura automatica dell'URI
        # (regola di nginx per i proxy_pass "dinamici"): la si fa a mano con
        # rewrite ... break. Contratto /api/v1 (GIT-151): si toglie solo /api,
        # come il Middleware strip-api dell'Ingress, così /api/v1/resources
        # arriva al gateway come /v1/resources.
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Raw dei file (regola B3, GIT-81): il browser apre
    # /<owner>/<repo>/raw/<ref>/<percorso> e il container lo riscrive su
    # /v1/repos/<owner>/<repo>/raw/<resto> verso il gateway
    # (getRepositoryRawByPath). Va prima del fallback SPA. Stesso schema di
    # /api/: proxy_pass con variabile non riscrive l'URI, serve rewrite ... break.
    # Niente buffering: il file passa in streaming. Le intestazioni di sicurezza
    # (nosniff, CSP sandbox, Content-Type, Content-Disposition) le scrive il
    # servizio git: nginx non le tocca. Nessun link anonimo: la sessione (cookie)
    # o il token li verifica il gateway.
    location ~ ^/[^/]+/[^/]+/raw/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $gateway_upstream "${GATEWAY_UPSTREAM}";
        rewrite ^/([^/]+)/([^/]+)/raw/(.*)$ /v1/repos/$1/$2/raw/$3 break;
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: qualunque percorso non statico ricade su index.html (routing lato
    # client, quando arriverà un router — vedi src/App.tsx).
    location / {
        try_files $uri /index.html;
    }
}
